# Lenovo(c) 2026 Apache 2.0
# Network configuration helper of confluent tenant %i: runs inside the
# tenant's network namespace as a user of its own and applies what the
# tenant's administrator manages there (addresses, routes, link state,
# name servers). It holds only CAP_NET_ADMIN and hands out no sockets.
[Unit]
Description=Confluent network configuration for tenant %i
BindsTo=confluent-netns@%i.service
After=confluent-netns@%i.service
Before=confluent-nsbroker@%i.service

[Service]
Type=simple
User=cfnet-%i
Group=cfnet-%i
NetworkNamespacePath=/run/netns/cf-%i
ExecStart=/opt/confluent/bin/confluent-netcfg --tenant %i --socket /run/confluent/ns/%i/netcfg/netcfg.sock --resolv /etc/netns/cf-%i/resolv.conf --allow-user confluent
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/confluent/ns/%i/netcfg /etc/netns/cf-%i/resolv.conf
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
MemoryMax=64M
TasksMax=32
LimitNOFILE=256
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
